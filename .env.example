APP_NAME=CVora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Kinshasa

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Production MySQL :
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cvora
# DB_USERNAME=cvora
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Vérification d'e-mail. false tant qu'aucun serveur mail n'est branché.
MUST_VERIFY_EMAIL=false

# Comptes de démonstration. Uniquement en APP_ENV=local, jamais en production.
SEED_DEMO=false

# Importation. Aligner cette valeur sur upload_max_filesize / post_max_size de PHP.
CVORA_IMPORT_MAX_KB=2048

# Intelligence artificielle. Un fournisseur n'est utilisable que si sa clé ET son modèle sont renseignés.
# Valeurs acceptées pour AI_DRIVER : anthropic, gemini, groq.
# openai n'est pas un fournisseur. Toute autre valeur est refusée et n'est pas remplacée.
# fake est réservé aux tests et refusé si APP_ENV=production.
# AI_FALLBACK_DRIVER est facultatif. Il doit nommer un autre fournisseur déjà configuré.
# GROQ_MODEL peut contenir une barre, par exemple organisation/modele.
# Aucun modèle n'est choisi à votre place : laissez le champ vide tant que vous n'avez pas vérifié l'identifiant.
# AI_TIMEOUT est le délai d'un appel, en secondes. La valeur du fichier .env du serveur l'emporte.
AI_DRIVER=anthropic
AI_FALLBACK_DRIVER=
AI_TIMEOUT=45
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Paiements. sandbox n'encaisse rien. ikeepay exige la clé secrète H2H.
# PAYMENT_WEBHOOK_SECRET ne sert qu'au bac à sable. iKeePay est revérifié par l'API avant activation.
PAYMENT_DRIVER=sandbox
PAYMENT_WEBHOOK_SECRET=
IKEEPAY_API_URL=https://api.ikeepay.com
IKEEPAY_API_KEY=
